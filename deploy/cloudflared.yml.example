# Cloudflare Tunnel configuration — ADVANCED (named tunnel with a stable hostname).
#
# The default is a temporary quick tunnel: just set TUNNEL=true in .env and start the app.
# To use this file instead:
#   cp deploy/cloudflared.yml.example deploy/cloudflared.yml
#   # fill in the tunnel UUID and the public hostname
#   # .env: TUNNEL=true and TUNNEL_QUICK=false
#   bun run start          # the app starts the tunnel and sends its URL to Telegram
#
# TRUST_PROXY defaults to 1 while TUNNEL=true, so the forwarded scheme/client IP are trusted.
# The app binds to loopback (`HOST=127.0.0.1`); Cloudflare terminates TLS at the edge and
# connects to cloudflared over an outbound TLS connection, so the access token never crosses
# the network in plaintext.
#
# `deploy/cloudflared.yml` is gitignored because it references the tunnel credentials.

tunnel: <TUNNEL_UUID>
credentials-file: /home/<user>/.cloudflared/<TUNNEL_UUID>.json

ingress:
  - hostname: bot.example.com
    service: http://127.0.0.1:3000
    originRequest:
      connectTimeout: 30s
      noTLSVerify: false
  # Everything else is rejected.
  - service: http_status:404
