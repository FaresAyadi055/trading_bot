# Required — the app refuses to start without it
ACCESS_TOKEN=

# live = real funds via the Binance spot API (api.binance.com)
# test = paper trading: real mainnet prices, simulated fills, fake USDT, own database in data-test/ (no keys)
MODE=test

# Spot API key (LIVE MODE ONLY — ignored in test mode): enable "Reading" + "Spot trading", NO withdrawals.
# Use IP whitelisting.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional
# PORT=3000
# DB_PATH=                        # live database (default data/trading.sqlite); in test mode it is the copy source
# PAPER_START_USDT=10000          # fake USDT seeded into a new paper account (test mode)
# TEST_DB_PATH=data-test/trading.sqlite  # paper database (test mode; never the live DB)
# TEST_DB_SOURCE=                 # live DB to copy into the paper DB (default: DB_PATH or data/trading.sqlite)
# TEST_DB_RESET=0                 # 1 = re-copy the live DB and reset the paper account on boot
# BINANCE_BASE_URL=https://api.binance.com   # real execution/account endpoint (live mode only)
# BINANCE_DATA_URL=https://api.binance.com   # public candles + universe data (mainnet in both modes)
# FETCH_DELAY_MS=5000
# STOP_POLL_SECONDS=15           # resting-stop reconciliation + backstop period (min 5)
# MAX_ENTRY_SLIPPAGE_PCT=1       # refuse a buy priced more than this above the reference
# BALANCE_TTL_SECONDS=10
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# HTTP hardening
# TRUST_PROXY=0                  # honour X-Forwarded-* / CF-Connecting-IP (Cloudflare Tunnel / reverse proxy)
# FORCE_HTTPS=1                  # set 0 only on a trusted LAN
# SESSION_SECRET=                # defaults to ACCESS_TOKEN
# SESSION_TTL_SECONDS=43200
# AUTH_RATE_LIMIT_MAX=5
# AUTH_RATE_LIMIT_WINDOW_SECONDS=300
# AUTH_RATE_LIMIT_BLOCK_SECONDS=900
# API_RATE_LIMIT_MAX=240
# API_RATE_LIMIT_WINDOW_SECONDS=60
