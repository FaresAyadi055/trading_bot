# Required — the app refuses to start without it
ACCESS_TOKEN=

# live = real funds via Binance Convert (api.binance.com) · test = spot testnet (testnet.binance.vision)
MODE=test

# Convert-only API key: enable "Reading" + the Convert/trade permission, NO withdrawals. Use IP whitelisting.
# In test mode use the keys generated at https://testnet.binance.vision
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional
# PORT=3000
# DB_PATH=data/trading.sqlite
# BINANCE_BASE_URL=            # execution/account endpoint (default: mainnet for live, testnet for test)
# BINANCE_DATA_URL=https://api.binance.com   # public candles + symbol list (always mainnet by default)
# FETCH_DELAY_MS=5000
# STOP_POLL_SECONDS=15         # how often open positions are checked against their stops
# INTERRUPT_MIN_SECONDS=120    # gap that counts as an interruption -> Telegram alert after reconnect
# BALANCE_TTL_SECONDS=10
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# MAX_ASSETS_PER_BOT=50
